{
  "name": "glanzwerk-vue-pinia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,VUE \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "pinia": "^3.0.1",
    "lucide-vue-next": "^0.468.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^8.0.0",
    "concurrently": "^9.1.2"
  }
}
